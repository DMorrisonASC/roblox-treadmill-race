{
	"compilerOptions": {
		// required
		"allowSyntheticDefaultImports": true,
		"downlevelIteration": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts", "node_modules/@flamework"],
		// Flamework is a compile-time transformer: without this entry every @Service/@Controller
		// decorator and every Flamework.addPaths() call is silently left un-rewritten, and the
		// runtime will find zero singletons while the build still reports success.
		"plugins": [{ "transform": "rbxts-transformer-flamework" }],

		// configurable
		"rootDir": "src",
		"outDir": "out",
		"baseUrl": "src",
		"incremental": true,
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo"
	},
	// Explicit, because the default `**/*` also matches `jest.config.ts` at the repo root — which lives outside
	// `rootDir: "src"` and is a Node-side file, not Luau. roblox-ts should compile `src` and nothing else.
	"include": ["src"]
}
